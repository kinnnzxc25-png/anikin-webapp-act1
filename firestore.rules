rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 255 &&
        data.name is string && data.name.size() <= 128 &&
        data.role in ['freelancer', 'client'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidPortal(data) {
      return data.keys().hasAll(['id', 'freelancerId', 'code', 'clientName', 'projectName', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.freelancerId is string && data.freelancerId.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.clientName is string && data.clientName.size() <= 128 &&
        data.projectName is string && data.projectName.size() <= 255 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidFile(data) {
      return data.keys().hasAll(['id', 'userId', 'originalName', 'storedName', 'mimeType', 'size', 'uploadDate', 'uploadedBy', 'category']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.originalName is string && data.originalName.size() <= 255 &&
        data.storedName is string && data.storedName.size() <= 255 &&
        data.mimeType is string && data.mimeType.size() <= 128 &&
        data.size is number && data.size > 0 &&
        data.uploadDate is string && data.uploadDate.size() <= 64 &&
        data.uploadedBy in ['freelancer', 'client'] &&
        data.category in ['image', 'document', 'design', 'archive', 'other'];
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.id == request.auth.uid);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (incoming().id == request.auth.uid || userId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (existing().id == request.auth.uid) && incoming().id == existing().id;
      allow delete: if false;
    }

    // Client Portals Collection
    match /portals/{portalId} {
      allow get: if true; // Public portal access by code
      allow list: if isSignedIn() && (resource.data.freelancerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(portalId) && isValidPortal(incoming()) && incoming().freelancerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(portalId) && isValidPortal(incoming()) && existing().freelancerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(portalId) && existing().freelancerId == request.auth.uid;
    }

    // Files Collection
    match /files/{fileId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && isValidId(fileId) && isValidFile(incoming()) && incoming().userId == request.auth.uid) ||
                       (isValidId(fileId) && isValidFile(incoming()) && incoming().uploadedBy == 'client');
      allow update: if isSignedIn() && isValidId(fileId) && isValidFile(incoming()) && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(fileId) && existing().userId == request.auth.uid;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
